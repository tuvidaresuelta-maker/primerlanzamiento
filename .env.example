# ============================================
# Primerlanzamiento - Variables de Entorno
# ============================================
# Copia este archivo como .env y completa los valores

# Servidor
PORT=3001
NODE_ENV=development

# Meta App Credentials (de developers.facebook.com)
APP_ID=tu_app_id_aqui
APP_SECRET=tu_app_secret_aqui

# Webhook Verification Token (genera uno único)
VERIFY_TOKEN=tu_token_secreto_unico_aqui

# OAuth Redirect URI (ngrok temporal o dominio final)
REDIRECT_URI=https://<TU-NGROK-ID>.ngrok.io/auth/facebook/callback

# Page Access Token (obtenido después del OAuth flow)
PAGE_ACCESS_TOKEN=

# Instagram Business Account ID (obtenido después de vincular)
INSTAGRAM_ACCOUNT_ID=

# Facebook Page ID
FACEBOOK_PAGE_ID=

# Long-Lived User Access Token (obtenido después del intercambio)
USER_ACCESS_TOKEN=
